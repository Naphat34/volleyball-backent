{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "node scripts/generateVisEngine.mjs --check && node scripts/generateAppTheme.mjs",
    "generate:vis-engine": "node scripts/generateVisEngine.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test src/**/*.test.js",
    "test:unit": "node --test src/**/*.test.js",
    "test:pwa": "node scripts/checkVisPwa.mjs",
    "test:i18n": "node --test src/utils/i18n/*.test.js src/utils/scorer/scorerTeamNames.test.js && node scripts/checkUiLanguages.mjs",
    "test:admin-vis": "node --test src/utils/vis/adminVims.test.js",
    "test:admin-center": "node --test src/utils/admin/controlCenter.test.js src/utils/vis/adminVims.test.js",
    "test:vis:timing": "node --test src/utils/vis/visTiming.test.js src/offline/visEngine.test.js src/utils/vis/visReportData.test.js src/utils/vis/visReportPdf.test.js",
    "test:vis:set-scores": "node --test src/utils/vis/visSetScores.test.js",
    "test:vis:p2": "node --test src/utils/vis/visP2Scores.test.js src/utils/vis/visReportData.test.js src/utils/vis/visReportPdf.test.js src/utils/vis/visMatchResultPdf.test.js",
    "generate:theme": "node scripts/generateAppTheme.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-pdf/renderer": "^4.3.2",
    "axios": "^1.13.3",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.563.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.37.0",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.7"
  }
}
