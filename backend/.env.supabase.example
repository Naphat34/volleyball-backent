# Supabase Session pooler: connection parameters from the supplied screenshot.
# Fill the two placeholders below, then use this file as backend/.env.
# Keep a private backup of the current backend/.env before replacing it.
# This template does not migrate or replace database contents.

PORT=5000
FRONTEND_URL=http://localhost:5173

DB_PROVIDER=postgres
# Required by the PostgreSQL adapter currently used in this repository.
DB_POSTGRES_PREVIEW=true
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.jwwpwqaagakbjekernsm
DB_PASSWORD="REPLACE_WITH_SUPABASE_DATABASE_PASSWORD"
DB_NAME=postgres
DB_PG_SCHEMA=volley
DB_POOL_MAX=5

DB_SSL=true
DB_SSL_CA_FILE=D:/webapp/volley/backend/config/certs/supabase-prod-ca-2021.crt

# Copy JWT_SECRET from your existing backend/.env; never put it in client/.env.
JWT_SECRET="COPY_EXISTING_JWT_SECRET_HERE"
JWT_EXPIRES_IN=7d

# Leave DATABASE_URL unset: it takes precedence over the DB_HOST/DB_USER fields.
# With the separate DB_PASSWORD field, URL percent-encoding is not required.

# Optional: only for the repository's explicit Supabase staging migration tools.
# Set this separately if you intend to use migrate:postgres:status/staging.
# Passwords in this URL MUST be percent-encoded when they contain special characters.
# STAGING_DATABASE_URL=postgresql://postgres.jwwpwqaagakbjekernsm:URL_ENCODED_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
