# Render service root directory: backend
# Template only: select the intended Supabase project before deploying.
NODE_ENV=production
DB_PROVIDER=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_DATABASE_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DB_SSL=true
DB_SSL_CA_FILE=./config/certs/supabase-prod-ca-2021.crt
DB_PG_SCHEMA=volley
DB_POOL_MAX=10

# The current adapter requires this opt-in. The existing project is staging.
# Enable only after selecting and verifying the deployment database.
# DB_POSTGRES_PREVIEW=true

CORS_ORIGINS=https://volleyball-94d.pages.dev,https://volleyball-backent.vercel.app
FRONTEND_URL=https://volleyball-backent.vercel.app
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true

# Preserve the existing Render JWT secret; never replace it with a placeholder.
# JWT_SECRET=<keep the existing value>
# PORT is supplied by Render; preserve its existing service configuration.
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME are MySQL settings and are unused
# when DB_PROVIDER=postgres. Keep them privately if required for rollback.
