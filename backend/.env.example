# Keep existing MySQL settings for rollback. Never commit real credentials.
DB_PROVIDER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=volley
DB_PASSWORD=
DB_NAME=volley
DB_SSL=false

# PostgreSQL STAGING ONLY until SQL/schema conversion and workflow tests pass.
# DB_PROVIDER=postgres
# DB_POSTGRES_PREVIEW=true
# DATABASE_URL=postgresql://postgres.PROJECT:PERCENT_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# DB_SSL=true
# DB_SSL_CA_FILE=D:/webapp/volley/backend/config/certs/supabase-prod-ca-2021.crt
DB_POOL_MAX=10
DB_PG_SCHEMA=volley
# Separate staging project only. Never point this at production.
# STAGING_DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres

# Preserve the current JWT secret during migration; do not replace it with this example.
JWT_SECRET=

# Render: allow the exact frontend origin (no trailing slash or URL path).
# Add other trusted frontend origins separated by commas when needed.
CORS_ORIGINS=https://volleyball-backent.vercel.app
